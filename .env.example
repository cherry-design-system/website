# Canonical site URL used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://cherry.al

# PostHog (optional). Without a key, analytics never initialises.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to the first-party /ingest proxy configured in next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=
# Set to "true" only after enabling cookieless mode in the PostHog project.
NEXT_PUBLIC_POSTHOG_COOKIELESS=false

# Dev only: comma-separated extra hosts allowed to load dev resources (e.g. a Tailscale URL).
ALLOWED_DEV_ORIGINS=
